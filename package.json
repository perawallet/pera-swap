{
  "name": "@perawallet/swap",
  "version": "1.0.0-beta.5",
  "description": "Algorand swap utilities and Pera Swap widget integration",
  "keywords": [
    "algorand",
    "iframe",
    "pera",
    "swap",
    "wallet",
    "widget"
  ],
  "homepage": "https://github.com/perawallet/pera-swap#readme",
  "bugs": {
    "url": "https://github.com/perawallet/pera-swap/issues"
  },
  "license": "MIT",
  "author": "Pera Wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perawallet/pera-swap.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('coverage',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --config .oxlintrc.types.json --type-aware src",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:package": "pnpm build && vitest run --project package",
    "test:browser": "pnpm build && playwright test",
    "test:live": "PERA_LIVE_API=1 vitest run --project live",
    "test:all": "pnpm test:coverage && pnpm test:integration && pnpm test:package && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm lint:types && pnpm typecheck && pnpm test:coverage && pnpm test:integration && pnpm test:package",
    "setup": "git config core.hooksPath tools/hooks",
    "example:dev": "pnpm build && pnpm --filter pera-swap-react-example dev",
    "example:build": "pnpm build && pnpm --filter pera-swap-react-example build",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "algosdk": "3.8.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "algosdk": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6"
}
